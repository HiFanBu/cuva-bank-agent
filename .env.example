# LLM provider: fake | ollama | bedrock
LLM_PROVIDER=fake

# Used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Used when LLM_PROVIDER=bedrock (not implemented in Phase 1, placeholder only)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# SQLite file path
DB_PATH=./data/cuva.db

# Confirmation TTL in seconds (spec: 10 minutes)
PENDING_ACTION_TTL_SECONDS=600

# Max agent loop steps (spec: 6)
MAX_AGENT_STEPS=6
